{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "bash": {
      "*": "allow",
      "Remove-Item *": "ask",
      "rm *": "ask",
      "git clean *": "ask",
      "git reset --hard*": "ask",
      "git push --force*": "ask",
      "Stop-Process *": "ask"
    }
  }
}
